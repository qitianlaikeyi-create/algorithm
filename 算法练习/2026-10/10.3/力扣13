class Solution {
public:
    int romanToInt(string s) {
        unordered_map<int,int>mp;
        mp['I']=1;
        mp['V']=5;
        mp['X']=10;
        mp['L']=50;
        mp['C']=100;
        mp['D']=500;
        mp['M']=1000;
        int l=s.size();
        int ans=0;
        for(int i=0;i<l;){
            if(s[i]=='I'){
                if(s[i+1]=='V'||s[i+1]=='X'){
                    ans+=mp[s[i+1]]-mp[s[i]];
                    i+=2;
                }
                else {ans+=mp[s[i]];i++;}
            }
            else if(s[i]=='X'){
                if(s[i+1]=='L'||s[i+1]=='C'){
                    ans+=mp[s[i+1]]-mp[s[i]];
                    i+=2;
                }
                else {ans+=mp[s[i]];i++;}
            }
            else if(s[i]=='C'){
                if(s[i+1]=='D'||s[i+1]=='M'){
                    ans+=mp[s[i+1]]-mp[s[i]];
                    i+=2;
                }
                else {ans+=mp[s[i]];i++;}
            }
            else {
                ans+=mp[s[i]];
                i++;
            }
        }
         return ans;
    }
};