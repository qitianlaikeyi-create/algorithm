class Solution {
public:
    bool isPalindrome(int x) {
        string s;
        bool ans=1;
        if(x<0)return false;
        while(x){
            int t=x%10;
            s+=to_string(t);
            x/=10;
        }
        string k=s;
        reverse(s.begin(),s.end());
        if(k==s)ans=1;
        else ans=0;
     return ans;
    }
};