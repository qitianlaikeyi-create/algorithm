#include<bits/stdc++.h>
using namespace std;
#define ll long long
int main(){
    int t;cin>>t;
    while(t--){
        int n;cin>>n;
        int ans=0;
        vector<int>a(n+1);
        for(int i=1;i<=n;i++){
            cin>>a[i];
        }
        ans=a[1];
        sort(a.begin()+2,a.end());
        for(int i=2;i<=n;i++){
            if(ans>a[i]){
                continue;
            }
            else{
                ans=(ans+a[i]+1)/2;
            }
        }
        cout<<ans<<endl;
    }
    return 0;
}
