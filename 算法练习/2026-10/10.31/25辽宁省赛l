#include<bits/stdc++.h>
using namespace std;
#define ll long long
const int N=2e3+100;
int ans[N][N]={0};
int main(){
    int t;cin>>t;
    while(t--){
    int n;cin>>n;
    vector<int>col(n+1);
    vector<int>row(n+1);
    for(int i=1;i<=n;i++){
        cin>>row[i];
    }
    for(int j=1;j<=n;j++){
        cin>>col[j];
    }
    for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            ans[i][j]=min(row[i]-1,col[j]-1);
            cout<<ans[i][j]<<" ";
        }
        cout<<endl;
    }
    cout<<endl;
    }
    return 0;
}