#include<bits/stdc++.h>
using namespace std;
#define ll long long

int main(){
    int n;cin>>n;
    vector<vector<int>>a(3);
    for(int i=1;i<=n;i++){
        int x,y,z;cin>>x>>y>>z;
        if(x==1){
            a[0].push_back(i);
        }
        if(y==1){
          a[1].push_back(i); 
        }
        if(z==1){
           a[2].push_back(i);
        }
    }
    int ans=3;
    for(int i=1;i<8;i++){
        int cnt=0;
        bool num[105]={0};
        bool ok=0;
        for(int j=0;j<3;j++){
            if(i&(1<<j)){
                cnt++;
                for(auto x:a[j]){
                    num[x]=1;
                }
            }
        }
        for(int i=1;i<=n;i++){
                if(!num[i]){
                    ok=1;break;
                }
            }
        if(!ok)ans=min(ans,cnt);
    }
    cout<<ans;
    return 0;
}
