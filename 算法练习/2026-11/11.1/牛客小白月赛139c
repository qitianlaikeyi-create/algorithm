#include<bits/stdc++.h>
using namespace std;
#define ll long long
const int N=2e5+100;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,x;cin>>n>>x;
        vector<int>a(n+1);
        for(int i=1;i<=n;i++){
            cin>>a[i];
        }
        if(n%2==0&&x==1){
            cout<<-1<<endl;
            continue;
        }
        ll ans=0;
        priority_queue<int,vector<int>,greater<int>>pq;
        int x1=0,x2=0;
        for(int i=1;i<=n;i++){
            pq.push(a[i]);
            if(x1+1-x2>x){
                int num=pq.top();
                pq.pop();
                ans+=num;
                x2++;
            }
            else {
                x1++;
            }
        }
        cout<<ans<<endl;
    }
    return 0;
}
