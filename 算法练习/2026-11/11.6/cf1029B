#include<bits/stdc++.h>
using namespace std;
using ll=unsigned long long;

int main(){
    int n;cin>>n;
    vector<int>a(n+1);
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    deque<int>dq;
    int ans=-1;
    for(int i=1;i<=n;i++){
       while(!dq.empty()&&dq.back()*2<a[i]){
        ans=max(ans,(int)dq.size());
       dq.pop_back();
        }
        dq.push_back(a[i]);
    }
    ans=max(ans,(int)dq.size());
    cout<<ans;
    return 0;
}