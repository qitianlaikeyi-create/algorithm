#include<bits/stdc++.h>
using namespace std;
#define ll long long
const int N=1e5+100;
int main() {
    int n;cin>>n;
    int a[N]={0},b[N]={0},c[N]={0},ans=0;
    for(int i=1;i<=n;i++){
        cin>>a[i];
    }
    sort(a+1,a+1+n,greater<int>());
    for(int i=1;i<=n;i++){
        c[i]=c[i-1]+a[i];
    }
    for(int i=1;i<n;i++){
        b[i]+=a[i]*2;
        b[i+1]+=c[i];
        ans=max(ans,b[i]);
    }
    b[n]+=a[n]*2;
    ans=max(ans,b[n]);
    cout<<ans;
    return 0;
}